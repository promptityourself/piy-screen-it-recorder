#!/usr/bin/env zsh
# Record both displays into two FCP-ready .mov files (one per screen) and the mic into its own
# file, as the app does: the mic never goes in a screen file. One ffmpeg run, so all three start
# together. The mic is AAC (mic.m4a), not the app's WAV: with a screen input, ffmpeg 9's
# avfoundation kept only ~1 s of any uncompressed or lossless mic output (WAV, FLAC, PCM .mov).
# Stop with Ctrl-C (or q) — ffmpeg then finalises the files cleanly.
set -euo pipefail

SCREENS=("Capture screen 0" "Capture screen 1")
MIC="${REC_MIC:-Shure Mic Pass-Thru}"
FPS="${REC_FPS:-30}"
SIZE="${REC_SIZE:-2560:1440}"
BITRATE="${REC_BITRATE:-12M}"
OUT="${REC_DIR:-$HOME/Movies/ScreenItRecorder}/$(date +%Y-%m-%d_%H%M%S)"

if [[ "${1:-}" == "-l" ]]; then
  ffmpeg -hide_banner -f avfoundation -list_devices true -i "" 2>&1 | grep -F 'AVFoundation' || true
  exit 0
fi

mkdir -p "$OUT"
echo "Recording to $OUT  (mic: $MIC, ${SIZE/:/x}@${FPS}fps) — Ctrl-C to stop, then clap."

args=(-hide_banner -loglevel warning -stats)
for s in "${SCREENS[@]}"; do
  args+=(-thread_queue_size 1024 -f avfoundation -capture_cursor 1 -framerate "$FPS" -pixel_format nv12 -i "${s}:none")
done
args+=(-thread_queue_size 1024 -f avfoundation -i "none:${MIC}")

audio_idx=${#SCREENS[@]}
for i in {1..${#SCREENS[@]}}; do
  n=$((i - 1))
  args+=(-map "${n}:v"
    -vf "scale=${SIZE}:flags=bicubic"
    -c:v hevc_videotoolbox -b:v "$BITRATE" -tag:v hvc1 -r "$FPS"
    "$OUT/screen$n.mov")
done
args+=(-map "${audio_idx}:a" -c:a aac -b:a 256k "$OUT/mic.m4a")

# Hide desktop widgets while recording; put them back the way they were on exit.
wcmd="${0:A:h}/widgets"
was=$("$wcmd" status)
trap '"$wcmd" "$was"; echo "Widgets restored ($was)."' EXIT
trap ':' INT  # a handler (not ignore) so ffmpeg still gets Ctrl-C and finalises
"$wcmd" off

ffmpeg "${args[@]}" || true
